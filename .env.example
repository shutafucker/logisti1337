# Backend: SQLite URL. Leave unset to use backend/data/logistiai.db.
# LOGISTIAI_DATABASE_URL=sqlite:////tmp/logistiai.db

# Server-side AI interpreter. Set these in the backend process environment or
# copy this file to .env; never commit a populated .env file.
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=15

# Frontend: optional API base URL. Leave unset in local development to use Vite's /api proxy.
# VITE_API_BASE_URL=http://localhost:8000
